# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.env
.venv/
venv/
env/

# Saved datasets. ClockWork's Export module writes NetCDF; these are
# regenerable from the raw files and are usually hundreds of MB.
*.nc

# Analysis output. Both land inside the working folder you choose, which is
# normally your data folder — but ignore them in case you point it at the repo.
Graph Exports/
Averaged Scalograms/

# Your own recordings. The committed example is re-included below; keep every
# other monitor file out, since a full-length one runs to tens of MB.
Monitor*.txt
!example_data/Monitor*.txt

# Tool cache (regenerated by `ruff check`)
.ruff_cache/

# OS / editor / assistant
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp

# Ad-hoc development output. `outputs/` collects the diagnostic plots and CSVs
# produced by throwaway analysis scripts (bandwidth sweeps, KDE comparisons);
# nothing in the codebase reads or writes it, and it runs to tens of MB.
outputs/

# Scratch spreadsheets used while poking at a dataset by hand.
scratch_test.xlsx
scratch_*.xlsx
